# Build output and local scratch (not committed). The lib/ FFI binaries are built by
# `make -C csrc`, not carried in git; releases ship them via packaging, not the repo.
/csrc/build/
/lib/*/libtessero.so
/lib/*/libtessero.dylib
/lib/*/tessero.dll
/ext/modules/
/ext/.libs/
/ext/*.lo
/ext/*.la
/ext/Makefile
/ext/config.h
/ext/autom4te.cache/
*.o
*.lo
__pycache__/
*.pyc

# Composer dev dependencies (PHPUnit etc.); installed with `composer install`, not committed
/vendor/
.phpunit.result.cache

# Local pinned parity environment (tools/setup-reference-host.sh)
/.venv-parity/

# ---- R&D process logs: disk only (owner directive 2026-10-20: code+tests+technical only) ----
/.work/

# phpize / configure / make output of an in-tree extension build (never commit)
/ext/build/
/ext/Makefile.fragments
/ext/Makefile.objects
/ext/acinclude.m4
/ext/aclocal.m4
/ext/config.h.in
/ext/config.log
/ext/config.nice
/ext/config.status
/ext/configure
/ext/configure.ac
/ext/install-sh
/ext/libtool
/ext/ltmain.sh
/ext/missing
/ext/mkinstalldirs
/ext/run-tests.php
/ext/include/
*.dep
/ext/tests/*.diff
/ext/tests/*.exp
/ext/tests/*.log
/ext/tests/*.out
/ext/tests/*.php
/ext/tests/*.sh
# the soname symlink created by csrc/Makefile (ADR 0014)
/lib/*/libtessero.so.*
/ext/*~
