$(phplibdir)/tessero.la: ./tessero.la
	$(LIBTOOL) --tag=CXX --mode=install cp ./tessero.la $(phplibdir)

./tessero.la: $(shared_objects_tessero) $(TESSERO_SHARED_DEPENDENCIES)
	$(LIBTOOL) --tag=CXX --mode=link $(CXX) -shared $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS)  -o $@ -export-dynamic -avoid-version -prefer-pic -module -rpath $(phplibdir) $(EXTRA_LDFLAGS) $(shared_objects_tessero) $(TESSERO_SHARED_LIBADD)

